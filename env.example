# Copy to .env and fill in (never commit .env)

# Mock mode = 1 → no OddsAPI HTTP (offline test)
# Mock mode = 0 → real Pinnacle when keys are set
BEAST_MOCK=1
BEAST_DEBUG=0

# theOddsAPI tokens (rotate on 401/429)
ODDS_API_KEY_1=
ODDS_API_KEY_2=
ODDS_API_KEY_3=
ODDS_API_KEY=

# Optional: path or URL to soft-book odds JSON
# SOFT_FEED_JSON=./data/soft_odds.json

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
